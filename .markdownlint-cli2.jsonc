{
  "config": {
    "MD007": {
      "indent": 4,
    },
    "MD013": {
      "line_length": 120,
      "tables": false,
      "code_blocks": false,
    },
    "MD024": {
      "siblings_only": true,
    },
    "MD033": {
      "allowed_elements": ["br"],
    },
    "MD036": false,
    "MD040": false,
    "MD041": false,
    "MD046": false,
    // 表の縦線の揃え方（markdownlint 0.40 で追加された規則）。既存の表は揃え方がまちまちなので止める
    "MD060": false,
  },
  // AGENTS.md は scripts/sync-agents.sh が生成する（直接編集しない）ので検査しない
  "ignores": ["_reference/**", "AGENTS.md"],
}
