<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VehicleVision.PleasanterTools.IdentityProvider.Core\VehicleVision.PleasanterTools.IdentityProvider.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DB の基盤（接続・暗号化検査・DbTime・マイグレーションと排他・SqlDialect の汎用部分）。Core のパッケージ。
         **Core が持つ依存（Dapper・FluentMigrator・DB ドライバなど）は、ここで宣言し直さない**（版のずれの原因になる）。Core 経由で受け取る -->
    <PackageReference Include="VehicleVision.PleasanterTools.Core.Data" Version="0.1.0-preview.4" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VehicleVision.PleasanterTools.IdentityProvider.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- DB の基盤は Core.Data（NuGet）へ集約した。名前空間を暗黙に使えるようにする -->
    <Using Include="VehicleVision.PleasanterTools.Core.Data" />
  </ItemGroup>

</Project>
